//@version=5
// Labo — Rebond corrigé (après audit). Réplique de labo/strategies/rebond_tp_sl.py + labo/rebond.py
// Graphiques : AMEX:SPY puis AMEX:GLD, unité 1D, données AJUSTÉES des dividendes (bouton « ADJ » activé).
// Signal à la clôture t (RSI-2 < 5 et clôture > MM200) → achat au cours de CLÔTURE de t+1.
// Sortie décidée à une clôture j (objectif +1 %, stop -10 % ou 20 séances) → vente à la clôture de j+1.
strategy("Labo Rebond", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.01,
     slippage=0, pyramiding=0, process_orders_on_close=true)
seuil = input.float(5, "Seuil RSI-2")
tp = input.float(1.0, "Objectif %") / 100
sl = input.float(10.0, "Stop %") / 100
duree = input.int(20, "Durée max (séances)")
signal = ta.rsi(close, 2) < seuil and close > ta.sma(close, 200)
var bool actif = false
var bool vendre = false
var int barreEntree = na
var float prixEntree = na
// 1) Exécution, à cette clôture, d'une décision prise à la clôture précédente
if vendre
    strategy.close("Long")
    vendre := false
    actif := false
else if not actif and signal[1]
    strategy.entry("Long", strategy.long)
    actif := true
    barreEntree := bar_index
    prixEntree := close
// 2) Décision de sortie à cette clôture (évaluée dès la séance d'entrée, comme le moteur Python)
if actif and not vendre
    g = close / prixEntree - 1
    if g >= tp or g <= -sl or (bar_index - barreEntree) >= duree
        vendre := true
